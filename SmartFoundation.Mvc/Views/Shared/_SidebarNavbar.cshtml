    var sessionGeneralNo = Context.Session.GetString("GeneralNo");
    var sessionnationalID = Context.Session.GetString("nationalID");
    var sessionAdminTypeID = Context.Session.GetString("AdminTypeID");
    var sessionAdminTypeName = Context.Session.GetString("AdminTypeName");
    var sessionIdaraName = Context.Session.GetString("IdaraName");
    // ✅ FIXED: Read changedPassword from session with proper default
    var sessionChangedPassword = Context.Session.GetString("ChangedPassword");

    // ✅ Debug: Log the value
    
    // ✅ Decision logic
     var mustChangePassword = sessionChangedPassword == "0";
    //var mustChangePassword = true;
    var sidebarMenuJson = JsonSerializer.Serialize(
        Model ?? new List<MenuItem>(),
