<!-- Change Password Modal -->
<div id="change-password-modal" tabindex="-1" aria-hidden="true"
     class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0">
    <div class="relative max-h-full w-full max-w-md p-4">
        <div class="relative rounded-lg border border-slate-700 bg-slate-800 shadow">
            <!-- Modal header -->
            <div class="flex items-center justify-between border-b border-slate-700 p-4">
                <h3 class="text-xl font-semibold text-white">
                    <i class="fa-solid fa-key me-2 text-emerald-400"></i>
                    تغيير كلمة المرور
                </h3>
                <button type="button"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-slate-400 hover:bg-slate-700 hover:text-white"
                        data-modal-hide="change-password-modal">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            
            <!-- Modal body -->
            <form id="change-password-form" class="p-4">
                <input type="text"
                       name="username"
                       value="@Context.Session.GetString("nationalID")"
                       autocomplete="username"
                       tabindex="-1"
                       aria-hidden="true"
                       class="sr-only"
                       hidden>
                <div class="space-y-4">
                    <!-- Current Password -->
                    <div>
                        <label for="current-password" class="mb-2 block text-sm font-medium text-white">
                            كلمة المرور الحالية
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="current-password"
                                   name="currentPassword"
                                   autocomplete="current-password"
                                   class="block w-full rounded-lg border border-slate-600 bg-slate-700 p-2.5 pe-10 text-sm text-white focus:border-emerald-500 focus:ring-emerald-500"
                                   placeholder="أدخل كلمة المرور الحالية"
                                   required>
                                    <button type="button"
                                            class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 hover:text-white"
                                            data-password-toggle="current-password"
                                            data-password-toggle-icon>
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                    </div>

                    <!-- New Password -->
                    <div>
                        <label for="new-password" class="mb-2 block text-sm font-medium text-white">
                            كلمة المرور الجديدة
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="new-password"
                                   name="newPassword"
                                   autocomplete="new-password"
                                   class="block w-full rounded-lg border border-slate-600 bg-slate-700 p-2.5 pe-10 text-sm text-white focus:border-emerald-500 focus:ring-emerald-500"
                                   placeholder="أدخل كلمة المرور الجديدة"
                                   minlength="12"
                                   required>
                                    <button type="button"
                                            class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 hover:text-white"
                                            data-password-toggle="new-password"
                                            data-password-toggle-icon>
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                        <p class="mt-1 text-xs text-slate-400">الحد الأدنى 12 خانة حروف انجليزية وارقام</p>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label for="confirm-password" class="mb-2 block text-sm font-medium text-white">
                            تأكيد كلمة المرور
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="confirm-password"
                                   name="confirmPassword"
                                   autocomplete="new-password"
                                   class="block w-full rounded-lg border border-slate-600 bg-slate-700 p-2.5 pe-10 text-sm text-white focus:border-emerald-500 focus:ring-emerald-500"
                                   placeholder="أعادة إدخال كلمة المرور الجديدة"
                                   required>
                                    <button type="button"
                                            class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 hover:text-white"
                                            data-password-toggle="confirm-password"
                                            data-password-toggle-icon>
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                    </div>

                    <!-- Error Message Area -->
                    <div id="password-error" class="hidden rounded-lg border border-red-800 bg-red-900/20 p-3 text-sm text-red-400"></div>

                    <!-- Password Strength Indicator -->
                    <div id="password-strength" class="mt-2 hidden">
                        <div class="flex items-center gap-2">
                            <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-600">
                                <div id="strength-bar" class="h-full transition-all duration-300"></div>
                            </div>
                            <span id="strength-text" class="text-xs font-medium"></span>
                        </div>
                        <ul class="mt-2 space-y-1 text-xs text-slate-400">
                            <li id="check-length" class="flex items-center gap-2">
                                <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                <span>12 خانة على الأقل</span>
                            </li>
                            <li id="check-uppercase" class="flex items-center gap-2">
                                <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                <span>حرف كبير (A-Z)</span>
                            </li>
                            <li id="check-lowercase" class="flex items-center gap-2">
                                <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                <span>حرف صغير (a-z)</span>
                            </li>
                            <li id="check-number" class="flex items-center gap-2">
                                <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                <span>رقم واحد (0-9)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="mt-4 flex items-center gap-3 border-t border-slate-700 pt-4">
                    <button type="submit"
                            class="w-full rounded-lg bg-emerald-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-emerald-700 focus:ring-4 focus:ring-emerald-300 focus:outline-none">
                        <i class="fa-solid fa-check me-2"></i>
                        حفظ كلمة المرور
                    </button>
                    <button type="button"
                            data-modal-hide="change-password-modal"
                            class="w-full rounded-lg border border-slate-600 bg-slate-700 px-5 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-600 hover:text-white">
                        إلغاء
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

