                                </div>
                                <p class="mt-1 text-xs text-slate-400">الحد الأدنى 12 خانة (حرف كبير، حرف صغير، رقم)</p>
                            </div>

                            <!-- Confirm Password -->
                            <div>
                                <label for="force-confirm-password" class="mb-2 block text-sm font-medium text-white">
                                    تأكيد كلمة المرور <span class="text-red-400">*</span>
                                </label>
                                <div class="relative">
                                    <input type="password"
                                           id="force-confirm-password"
                                           name="confirmPassword"
                                           autocomplete="new-password"
                                           class="block w-full rounded-lg border border-slate-600 bg-slate-700 p-2.5 pe-12 text-sm text-white focus:border-red-500 focus:ring-red-500 md:p-3 md:text-base"
                                           placeholder="أعادة إدخال كلمة المرور الجديدة"
                                           required>
                                    <button type="button"
                                            class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 hover:text-white"
                                            data-password-toggle="force-confirm-password"
                                            data-password-toggle-icon>
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Password Strength Indicator -->
                            <div id="force-password-strength" class="hidden">
                                <div class="flex items-center gap-2">
                                    <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-600">
                                        <div id="force-strength-bar" class="h-full transition-all duration-300"></div>
                                    </div>
                                    <span id="force-strength-text" class="text-xs font-medium"></span>
                                </div>
                                <ul class="mt-2 space-y-1 text-xs text-slate-400">
                                    <li id="force-check-length" class="flex items-center gap-2">
                                        <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                        <span>12 خانة على الأقل</span>
                                    </li>
                                    <li id="force-check-uppercase" class="flex items-center gap-2">
                                        <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                        <span>حرف كبير (A-Z)</span>
                                    </li>
                                    <li id="force-check-lowercase" class="flex items-center gap-2">
                                        <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                        <span>حرف صغير (a-z)</span>
                                    </li>
                                    <li id="force-check-number" class="flex items-center gap-2">
                                        <i class="fa-solid fa-circle-xmark text-red-400"></i>
                                        <span>رقم واحد (0-9)</span>
                                    </li>
                                </ul>
                            </div>

                            <!-- Error Message Area -->
                            <div id="force-password-error" class="hidden rounded-lg border border-red-800 bg-red-900/20 p-3 text-sm text-red-400"></div>
                        </div>

                        <!-- Modal footer -->
                        <div class="mt-4 grid grid-cols-1 gap-3 border-t border-slate-700 pt-4 md:mt-5 md:grid-cols-2 md:pt-5">
                            <button type="submit"
                                    class="rounded-lg bg-red-600 px-6 py-3 text-center text-base font-medium text-white hover:bg-red-700 focus:ring-4 focus:ring-red-300 focus:outline-none">
                                <i class="fa-solid fa-shield-halved me-2"></i>
                                تغيير كلمة المرور الآن
                            </button>
                            <a href="/Login/Logout"
                                   class="rounded-lg border border-slate-600 bg-slate-700 px-6 py-3 text-center text-base font-medium text-slate-300 hover:bg-slate-600 hover:text-white">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>
                                تسجيل الخروج
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
