@{
    Layout = null;
    ViewData["Title"] = "تغيير كلمة المرور مطلوب";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    var antiforgeryToken =
        Antiforgery.GetAndStoreTokens(Context).RequestToken
        ?? string.Empty;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <meta name="viewport"
          content="width=device-width,
                   initial-scale=1,
                   shrink-to-fit=no,
                   user-scalable=no,
                   minimal-ui" />

    <meta name="request-verification-token"
          content="@antiforgeryToken" />

    <link rel="icon"
          href="~/img/Royal_Saudi_Land_Forces.png" />

    <title>تغيير كلمة المرور مطلوب</title>

    <!-- نفس هوية صفحة تسجيل الدخول -->
    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />

    <!-- FontAwesome -->
    <link rel="stylesheet"
          href="/css/Fontawesome6-5-0.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/fontawesome/css/all.min.css"
          asp-append-version="true" />

    <style>

        .password-change-card {
            width: 100%;
            max-width: 590px;
        }

        .password-change-info {
            margin-top: 1rem;
            padding: 14px 16px;
            border: 1px solid #dbeafe;
            border-radius: 10px;
            background: #eff6ff;
            color: #475569;
            font-size: 14px;
            line-height: 1.9;
        }

        .password-change-info-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
            color: #1e3a8a;
            font-weight: 700;
        }

        .password-field {
            margin-top: 17px;
        }

        .password-field:first-child {
            margin-top: 0;
        }

        .password-label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

        .password-input-wrapper {
            position: relative;
        }

        .password-input-icon {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;

            display: flex;
            align-items: center;

            padding-right: 13px;

            color: #64748b;
            pointer-events: none;
        }

        .password-toggle {
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;

            display: flex;
            align-items: center;

            border: 0;
            background: transparent;

            padding-left: 13px;

            color: #64748b;
            cursor: pointer;
        }

        .password-toggle:hover {
            color: #2563eb;
        }

        .password-input {
            width: 100%;
            min-width: 100% !important;

            border: 1px solid #cbd5e1;
            border-radius: 8px;

            padding: 12px 42px 12px 42px;

            background: #ffffff;
            color: #0f172a;

            font-size: 14px;

            outline: none;

            transition:
                border-color .15s ease,
                box-shadow .15s ease;
        }

        .password-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, .12);
        }

        /* ==============================
           Password Strength
        ============================== */

        .password-strength {
            margin-top: 11px;
            padding: 12px 14px;

            border: 1px solid #e2e8f0;
            border-radius: 9px;

            background: #f8fafc;
        }

        .password-strength.hidden {
            display: none;
        }

        .password-strength-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 7px;

            color: #64748b;
            font-size: 12px;
        }

        .password-strength-title {
            font-weight: 600;
        }

        .password-strength-text {
            font-weight: 700;
        }

        .password-strength-track {
            width: 100%;
            height: 7px;

            overflow: hidden;

            border-radius: 999px;
            background: #e2e8f0;
        }

        .password-strength-bar {
            width: 0;
            height: 100%;

            border-radius: inherit;

            transition:
                width .25s ease,
                background-color .25s ease;
        }

        .strength-weak {
            background: #ef4444;
        }

        .strength-medium {
            background: #f59e0b;
        }

        .strength-good {
            background: #3b82f6;
        }

        .strength-strong {
            background: #10b981;
        }

        .password-strength-text.strength-weak-text {
            color: #dc2626;
        }

        .password-strength-text.strength-medium-text {
            color: #d97706;
        }

        .password-strength-text.strength-good-text {
            color: #2563eb;
        }

        .password-strength-text.strength-strong-text {
            color: #059669;
        }

        /* ==============================
           Password Rules
        ============================== */

        .password-rules {
            display: grid;
            gap: 5px;

            margin-top: 10px;

            padding: 0;
            list-style: none;
        }

        .password-rule {
            display: flex;
            align-items: center;
            gap: 7px;

            color: #64748b;
            font-size: 12px;

            transition: color .15s ease;
        }

        .password-rule i {
            width: 15px;
            text-align: center;
        }

        .password-rule.invalid {
            color: #dc2626;
        }

        .password-rule.valid {
            color: #059669;
        }

        /* ==============================
           Confirm match
        ============================== */

        .password-match {
            display: flex;
            align-items: center;
            gap: 6px;

            margin-top: 7px;

            font-size: 12px;
            font-weight: 600;
        }

        .password-match.hidden {
            display: none;
        }

        .password-match.match-success {
            color: #059669;
        }

        .password-match.match-error {
            color: #dc2626;
        }

        /* ==============================
           Error
        ============================== */

        .password-error-box {
            margin-top: 16px;
            padding: 11px 13px;

            border: 1px solid #fecaca;
            border-radius: 8px;

            background: #fef2f2;
            color: #b91c1c;

            font-size: 13px;
            line-height: 1.7;
        }

        .password-error-box.hidden {
            display: none;
        }

        /* ==============================
           Buttons
        ============================== */

        .password-change-actions {
            margin-top: 22px;
        }

        .password-change-submit {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;

            width: 100%;

            border: 0;
            border-radius: 8px;

            padding: 12px 16px;

            background: #2563eb;
            color: #ffffff;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            transition: background .15s ease;
        }

        .password-change-submit:hover {
            background: #1d4ed8;
        }

        .password-change-submit:disabled {
            cursor: not-allowed;
            opacity: .65;
        }

        .password-change-logout {
            margin-top: 18px;
            text-align: center;
        }

        .password-change-logout button {
            border: 0;
            background: transparent;

            color: #64748b;

            font-size: 14px;

            text-decoration: underline;
            cursor: pointer;
        }

        .password-change-logout button:hover {
            color: #2563eb;
        }

        @@media (max-width: 640px) {

            .password-change-card {
                max-width: 100%;
            }

        }

    </style>
</head>

<body class="login-page">

    <div class="login-shell relative isolate -m-3 h-screen p-3 contain-paint motion-safe:will-change-transform sm:-mx-8 dark:bg-darkmode-800 xl:dark:bg-darkmode-600 sm:px-8 lg:overflow-hidden xl:bg-white">

        <div class="login-container relative z-10 container sm:px-10">

            <div class="login-center">

                <!-- =========================
                     Brand
                ========================== -->

                <div class="login-brand-top">

                    <img class="login-brand-logo"
                         src="~/img/ppng.png"
                         alt="KFMC" />

                    <div class="login-brand-title">
                        المنصة الالكترونية الموحدة
                    </div>

                </div>

                <!-- =========================
                     Form Card
                ========================== -->

                <div class="login-form-col my-10 flex h-screen py-5 xl:my-0 xl:h-auto xl:py-0">

                    <div class="login-form-card password-change-card mx-auto my-auto rounded-md bg-white px-7 py-8 shadow-md sm:px-10 xl:bg-transparent xl:shadow-none dark:bg-darkmode-600">

                        <h2 class="intro-x login-title">

                            <span class="login-title-inner">

                                <span class="login-icon"
                                      aria-hidden="true">
                                    🔐
                                </span>

                                <span class="login-text">
                                    تغيير كلمة المرور
                                </span>

                            </span>

                        </h2>

                        <!-- =========================
                             Information
                        ========================== -->

                        <div class="intro-x password-change-info">

                            <div class="password-change-info-title">

                                <i class="fa-solid fa-shield-halved"></i>

                                <span>
                                    يجب تغيير كلمة المرور قبل استخدام النظام
                                </span>

                            </div>

                            <div>
                                تم تسجيل الدخول باستخدام كلمة مرور مؤقتة.
                                يرجى إنشاء كلمة مرور جديدة خاصة بك.
                            </div>

                            <div>
                                صلاحية كلمة المرور المؤقتة
                                <strong>24 ساعة</strong>
                                من وقت إنشائها أو إعادة تعيينها.
                            </div>

                        </div>

                        <!-- =========================
                             Form
                        ========================== -->

                        <form id="change-password-required-form"
                            method="post"
                            action="/Login/ChangePassword"
                            class="intro-x mt-6"
                            novalidate>

                            @Html.AntiForgeryToken()

                            <!-- Username for browser password managers -->
                            <input type="text"
                                   name="username"
                                   value="@Context.Session.GetString("nationalID")"
                                   autocomplete="username"
                                   tabindex="-1"
                                   aria-hidden="true"
                                   class="sr-only"
                                   hidden />

                            <!-- Current Password -->

                            <div class="password-field">

                                <label for="current-password"
                                       class="password-label">
                                    كلمة المرور المؤقتة الحالية
                                </label>

                                <div class="password-input-wrapper">

                                    <input id="current-password"
                                           name="currentPassword"
                                           type="password"
                                           autocomplete="current-password"
                                           required
                                           placeholder="أدخل كلمة المرور المؤقتة"
                                           class="password-input" />

                                    <span class="password-input-icon">
                                        <i class="fa-solid fa-lock"></i>
                                    </span>

                                    <button type="button"
                                            class="password-toggle"
                                            data-password-toggle="current-password"
                                            aria-label="إظهار أو إخفاء كلمة المرور">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>

                                </div>

                            </div>

                            <!-- New Password -->

                            <div class="password-field">

                                <label for="new-password"
                                       class="password-label">
                                    كلمة المرور الجديدة
                                </label>

                                <div class="password-input-wrapper">

                                    <input id="new-password"
                                           name="newPassword"
                                           type="password"
                                           autocomplete="new-password"
                                           minlength="12"
                                           required
                                           placeholder="أدخل كلمة المرور الجديدة"
                                           class="password-input" />

                                    <span class="password-input-icon">
                                        <i class="fa-solid fa-key"></i>
                                    </span>

                                    <button type="button"
                                            class="password-toggle"
                                            data-password-toggle="new-password"
                                            aria-label="إظهار أو إخفاء كلمة المرور">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>

                                </div>

                                <!-- Password Strength -->

                                <div id="password-strength"
                                     class="password-strength hidden">

                                    <div class="password-strength-header">

                                        <span class="password-strength-title">
                                            قوة كلمة المرور
                                        </span>

                                        <span id="strength-text"
                                              class="password-strength-text">
                                        </span>

                                    </div>

                                    <div class="password-strength-track">

                                        <div id="strength-bar"
                                             class="password-strength-bar">
                                        </div>

                                    </div>

                                    <ul class="password-rules">

                                        <li id="check-length"
                                            class="password-rule invalid">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            <span>
                                                12 خانة على الأقل
                                            </span>

                                        </li>

                                        <li id="check-uppercase"
                                            class="password-rule invalid">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            <span>
                                                حرف كبير (A-Z)
                                            </span>

                                        </li>

                                        <li id="check-lowercase"
                                            class="password-rule invalid">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            <span>
                                                حرف صغير (a-z)
                                            </span>

                                        </li>

                                        <li id="check-number"
                                            class="password-rule invalid">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            <span>
                                                رقم واحد (0-9)
                                            </span>

                                        </li>

                                    </ul>

                                </div>

                            </div>

                            <!-- Confirm Password -->

                            <div class="password-field">

                                <label for="confirm-password"
                                       class="password-label">
                                    تأكيد كلمة المرور الجديدة
                                </label>

                                <div class="password-input-wrapper">

                                    <input id="confirm-password"
                                           name="confirmPassword"
                                           type="password"
                                           autocomplete="new-password"
                                           required
                                           placeholder="أعد إدخال كلمة المرور الجديدة"
                                           class="password-input" />

                                    <span class="password-input-icon">
                                        <i class="fa-solid fa-check"></i>
                                    </span>

                                    <button type="button"
                                            class="password-toggle"
                                            data-password-toggle="confirm-password"
                                            aria-label="إظهار أو إخفاء كلمة المرور">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>

                                </div>

                                <div id="password-match"
                                     class="password-match hidden">
                                </div>

                            </div>

                            <!-- Error -->

                            <div id="password-error"
                                 class="password-error-box hidden">
                            </div>

                            <!-- Submit -->

                            <div class="password-change-actions">

                                <button id="btn-change-password"
                                        type="submit"
                                        class="password-change-submit">

                                    <i class="fa-solid fa-shield-halved"></i>

                                    <span id="btn-change-password-text">
                                        تغيير كلمة المرور وتسجيل الدخول
                                    </span>

                                    <i id="btn-change-password-spinner"
                                       class="fa-solid fa-spinner fa-spin"
                                       style="display:none;">
                                    </i>

                                </button>

                            </div>

                        </form>

                        <!-- =========================
                             Logout
                        ========================== -->

                        <form method="post"
                              action="/Login/Logout"
                              class="password-change-logout">

                            @Html.AntiForgeryToken()

                            <button type="submit">

                                <i class="fa-solid fa-right-from-bracket"></i>

                                تسجيل الخروج

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================
         Footer
    ========================== -->

    <div class="powered-center login-powered">

        جميع الحقوق محفوظة © مدينة الملك فيصل العسكرية
        2025 -
        <span id="currentYear"></span>

    </div>

    <script>
        document.getElementById("currentYear").textContent =
            new Date().getFullYear();
    </script>

    <script src="~/js/antiforgery.js"
            asp-append-version="true"></script>

    <script src="~/js/change-password-required.js"
            asp-append-version="true"></script>

</body>
</html>