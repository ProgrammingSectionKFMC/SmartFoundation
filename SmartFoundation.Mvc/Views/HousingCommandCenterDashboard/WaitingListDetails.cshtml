
@model SmartFoundation.UI.ViewModels.SmartCharts.DepWaitingListDetailsViewModel
@using System.Globalization

@{
    Layout = null;

    var rows = Model.Rows
        ?? new List<SmartFoundation.UI.ViewModels.SmartCharts.DepWaitingListDetailRow>();

    var accent = "#2b6cb0";

    string Fmt(long value) =>
        value.ToString("N0", CultureInfo.InvariantCulture);

    string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    string FmtDate(DateTime? value) =>
        value.HasValue
            ? value.Value.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture)
            : "—";

    string FmtDecisionDate(string? value) =>
        string.IsNullOrWhiteSpace(value)
            ? "—"
            : value.Replace("-", "/");

    string StageName(string stage) =>
        stage switch
        {
            "WAITING" => "في الانتظار",
            "ALLOCATION" => "في مراحل التخصيص",
            "HOUSING" => "في مراحل التسكين",
            _ => "—"
        };

    long startRow = Model.TotalRows <= 0
        ? 0
        : ((long)(Model.PageNumber - 1) * Model.PageSize) + 1;

    long endRow = Model.TotalRows <= 0
        ? 0
        : Math.Min((long)Model.PageNumber * Model.PageSize, Model.TotalRows);
}

<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>@Model.Title</title>

    <link rel="stylesheet"
          href="~/css/Fontawesome6-5-0.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/lib/fontawesome/css/all.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/statistics.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/smartcharts/smartcharts.housingcommandcenter.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/smartcharts/smartcharts.housingdepartment.css"
          asp-append-version="true" />

    <style>
        :root {
            --fin-accent: #2b6cb0;
            --fin-border: #e2e8f0;
            --fin-bg: #f6f8fb;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--fin-bg);
            color: #1e293b;
        }

        .fin-wrap {
            width: min(1900px, calc(100% - 28px));
            margin: 18px auto;
        }

        .fin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }

        .fin-stat {
            background: #fff;
            border: 1px solid var(--fin-border);
            border-radius: 13px;
            min-height: 84px;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .fin-stat > i {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: #edf4fb;
            color: var(--fin-accent);
            font-size: 17px;
        }

        .fin-stat strong {
            display: block;
            color: #0f172a;
            font-size: 19px;
            font-weight: 900;
        }

        .fin-stat span {
            display: block;
            margin-top: 5px;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
        }

        .fin-panel {
            background: #fff;
            border: 1px solid var(--fin-border);
            border-radius: 14px;
            overflow: hidden;
        }

        .fin-toolbar {
            display: grid;
            grid-template-columns: minmax(250px, 1fr) 110px auto;
            gap: 9px;
            padding: 12px;
            border-bottom: 1px solid var(--fin-border);
            align-items: center;
        }

        .fin-field {
            position: relative;
            min-width: 0;
        }

        .fin-field > i {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

        .fin-input,
        .fin-select {
            width: 100%;
            height: 39px;
            border: 1px solid #dbe3ed;
            border-radius: 9px;
            background: #fff;
            color: #334155;
            outline: none;
            font-size: 12px;
            font-weight: 700;
        }

        .fin-input { padding: 0 36px 0 10px; }
        .fin-select { padding: 0 10px; }

        .fin-actions {
            display: flex;
            gap: 7px;
        }

        .fin-btn {
            min-height: 39px;
            border-radius: 9px;
            border: 1px solid #dbe3ed;
            padding: 0 14px;
            background: #fff;
            color: #475569;
            font-size: 11px;
            font-weight: 900;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .fin-btn.primary {
            border-color: var(--fin-accent);
            background: var(--fin-accent);
            color: #fff;
        }

        .fin-table-scroll {
            width: 100%;
            overflow: auto;
            min-height: 350px;
            max-height: calc(100vh - 335px);
        }

        .fin-table {
            width: 100%;
            min-width: 1250px;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 11px;
        }

        .fin-table th {
            position: sticky;
            top: 0;
            z-index: 3;
            padding: 10px 8px;
            background: #f8fafc;
            border-bottom: 1px solid #dbe3ed;
            color: #475569;
            text-align: right;
            white-space: nowrap;
            font-weight: 900;
        }

        .fin-table td {
            padding: 9px 8px;
            border-bottom: 1px solid #edf2f7;
            color: #334155;
            vertical-align: middle;
            white-space: nowrap;
        }

        .fin-table tbody tr:hover {
            background: #f8fbff;
        }

        .fin-index {
            color: #94a3b8;
            font-weight: 800;
            text-align: center;
        }

        .fin-name {
            max-width: 240px;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 800;
        }

        .fin-date {
            direction: ltr;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .fin-chip {
            display: inline-flex;
            align-items: center;
            min-height: 25px;
            padding: 4px 9px;
            border-radius: 999px;
            border: 1px solid #dbe5ef;
            background: #f3f8ff;
            color: #2b6cb0;
            font-size: 10px;
            font-weight: 900;
        }

        .fin-chip.waiting {
            background: #edf7f5;
            color: #0f766e;
            border-color: #cceae4;
        }

        .fin-chip.housing {
            background: #edf7ef;
            color: #276749;
            border-color: #cce7d5;
        }

        .fin-empty {
            min-height: 350px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 8px;
            color: #94a3b8;
        }

        .fin-pager {
            min-height: 54px;
            padding: 10px 12px;
            border-top: 1px solid var(--fin-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .fin-pager-info {
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
        }

        .fin-page-controls {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .fin-page-btn {
            height: 32px;
            min-width: 34px;
            border: 1px solid #dbe3ed;
            border-radius: 8px;
            background: #fff;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-weight: 900;
        }

        .fin-page-btn.disabled {
            opacity: .4;
            pointer-events: none;
        }

        .fin-page-current {
            min-width: 90px;
            text-align: center;
            color: #334155;
            font-size: 11px;
            font-weight: 900;
        }

        @@media (max-width: 720px) {
            .fin-stats {
                grid-template-columns: repeat(2, minmax(0,1fr));
            }

            .fin-toolbar {
                grid-template-columns: 1fr;
            }

            .fin-actions {
                display: flex;
            }

            .fin-table-scroll {
                max-height: none;
            }

            .fin-pager {
                flex-wrap: wrap;
            }
        }

        @@media print {
            .fin-toolbar,
            .fin-pager,
            .dep-hdr-back {
                display: none !important;
            }

            .fin-wrap {
                width: 100%;
                margin: 0;
            }

            .fin-table-scroll {
                overflow: visible;
                max-height: none;
            }

            .fin-table {
                min-width: 0;
                font-size: 8px;
            }
        }
    </style>
</head>

<body>

<header class="dep-hdr">
    <div class="dep-hdr-bg"></div>
    <div class="dep-hdr-grid"></div>

    <a href="@Url.Action("Department", "HousingCommandCenterDashboard", new { id = Model.DepartmentId })#t8"
       class="dep-hdr-back">
        <i class="fa-solid fa-arrow-right"></i>
        العودة
    </a>

    <div class="dep-hdr-body">
        <div class="dep-hdr-main">
            <div class="dep-hdr-icon">
                <i class="fa-solid fa-list-ol"></i>
            </div>

            <div class="dep-hdr-copy">
                <div class="dep-hdr-label">
                    <span class="dep-hdr-dot"></span>
                    قوائم الانتظار — تفاصيل المستفيدين
                </div>

                <div class="dep-hdr-name">
                    @Model.Title
                </div>
            </div>
        </div>

        <div class="dep-hdr-stats">
            <div class="dep-hdr-stat">
                <span class="dep-hdr-stat-val">
                    @Fmt(Model.TotalRows)
                </span>
                <span class="dep-hdr-stat-lbl">سجل</span>
            </div>

            <div class="dep-hdr-stat">
                <span class="dep-hdr-stat-val">
                    @DateTime.Now.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                </span>
                <span class="dep-hdr-stat-lbl">
                    @DateTime.Now.ToString("dddd", new CultureInfo("ar-SA"))
                </span>
            </div>
        </div>
    </div>

    <div class="dep-hdr-bar">
        <div class="dep-hdr-bar-fill"
             style="width:100%;background:@accent">
        </div>
    </div>
</header>

<main class="fin-wrap">

    <section class="fin-stats">

        <div class="fin-stat">
            <i class="fa-solid fa-users"></i>
            <div>
                <strong>@Fmt(Model.TotalRows)</strong>
                <span>إجمالي السجلات المطابقة</span>
            </div>
        </div>

        <div class="fin-stat">
            <i class="fa-solid fa-list-ol"></i>
            <div>
                <strong>@Model.PageNumber / @Model.TotalPages</strong>
                <span>الصفحة الحالية</span>
            </div>
        </div>

        <div class="fin-stat">
            <i class="fa-solid fa-list-check"></i>
            <div>
                <strong>@rows.Count</strong>
                <span>السجلات المعروضة في الصفحة</span>
            </div>
        </div>

    </section>

    <section class="fin-panel">

        <form method="get"
              action="@Url.Action("WaitingListDetails", "HousingCommandCenterDashboard")"
              class="fin-toolbar"
              id="wl-details-filter">

            <input type="hidden" name="id" value="@Model.DepartmentId" />
            <input type="hidden" name="mode" value="@Model.Mode" />
            <input type="hidden" name="waitingClassID" value="@Model.WaitingClassID" />
            <input type="hidden" name="pageNumber" value="1" />

            <div class="fin-field">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search"
                       class="fin-input"
                       name="searchText"
                       value="@Model.SearchText"
                       autocomplete="off"
                       placeholder="بحث بالاسم أو الرقم العام أو رقم الهوية..." />
            </div>

            <div class="fin-field">
                <select class="fin-select" name="pageSize" id="wl-details-page-size">
                    <option value="25" selected="@(Model.PageSize == 25)">25 صف</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 صف</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100 صف</option>
                </select>
            </div>

            <div class="fin-actions">
                <button type="submit" class="fin-btn primary">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    بحث
                </button>

                <a class="fin-btn"
                   href="@Url.Action("WaitingListDetails", "HousingCommandCenterDashboard", new {
                       id = Model.DepartmentId,
                       mode = Model.Mode,
                       waitingClassID = Model.WaitingClassID,
                       pageSize = Model.PageSize
                   })">
                    <i class="fa-solid fa-rotate-left"></i>
                    مسح
                </a>
            </div>
        </form>

        <div class="fin-table-scroll">

            @if (rows.Any())
            {
                <table class="fin-table">
                    <thead>
                        <tr>
                            <th>م</th>
                            <th>الرقم العام</th>
                            <th>الرتبة</th>
                            <th>اسم المستفيد</th>
                            <th>رقم الهوية</th>
                            <th>فئة الانتظار</th>
                            <th>رقم القرار</th>
                            <th>تاريخ القرار</th>
                            <th>المرحلة الحالية</th>
                            <th>آخر إجراء</th>
                            <th>رقم المنزل</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in rows)
                        {
                            var stageCss =
                                row.WaitingStage == "WAITING"
                                    ? "waiting"
                                    : row.WaitingStage == "HOUSING"
                                        ? "housing"
                                        : "";

                            <tr>
                                <td class="fin-index">
                                    @Fmt(row.WaitingListOrder)
                                </td>

                                <td>
                                    @Display(row.GeneralNo)
                                </td>

                                <td>
                                    @Display(row.RankName)
                                </td>

                                <td class="fin-name" title="@row.FullName">
                                    @Display(row.FullName)
                                </td>

                                <td>
                                    @Display(row.NationalID)
                                </td>

                                <td>
                                    @Display(row.WaitingClassName)
                                </td>

                                <td>
                                    @Display(row.ActionDecisionNo)
                                </td>

                                <td class="fin-date">
                                    @FmtDecisionDate(row.ActionDecisionDate)
                                </td>

                                <td>
                                    <span class="fin-chip @stageCss">
                                        @StageName(row.WaitingStage)
                                    </span>
                                </td>

                                <td>
                                    @Display(row.LastActionTypeName)
                                </td>

                                <td>
                                    @Display(row.BuildingDetailsNo)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="fin-empty">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <strong>لا توجد نتائج مطابقة</strong>
                    <span>تحقق من البحث أو الفلاتر المستخدمة.</span>
                </div>
            }
        </div>

        <div class="fin-pager">
            <div class="fin-pager-info">
                @if (Model.TotalRows > 0)
                {
                    <span>
                        عرض @Fmt(startRow) - @Fmt(endRow)
                        من @Fmt(Model.TotalRows) سجل
                    </span>
                }
                else
                {
                    <span>لا توجد نتائج</span>
                }
            </div>

            <div class="fin-page-controls">

                <a class="fin-page-btn @(Model.HasPreviousPage ? "" : "disabled")"
                   aria-disabled="@(!Model.HasPreviousPage)"
                   href="@Url.Action("WaitingListDetails", "HousingCommandCenterDashboard", new {
                       id = Model.DepartmentId,
                       mode = Model.Mode,
                       waitingClassID = Model.WaitingClassID,
                       searchText = Model.SearchText,
                       pageNumber = Model.PageNumber - 1,
                       pageSize = Model.PageSize
                   })">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>

                <span class="fin-page-current">
                    @(Model.TotalPages > 0
                        ? $"{Model.PageNumber} / {Model.TotalPages}"
                        : "0 / 0")
                </span>

                <a class="fin-page-btn @(Model.HasNextPage ? "" : "disabled")"
                   aria-disabled="@(!Model.HasNextPage)"
                   href="@Url.Action("WaitingListDetails", "HousingCommandCenterDashboard", new {
                       id = Model.DepartmentId,
                       mode = Model.Mode,
                       waitingClassID = Model.WaitingClassID,
                       searchText = Model.SearchText,
                       pageNumber = Model.PageNumber + 1,
                       pageSize = Model.PageSize
                   })">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>

            </div>
        </div>

    </section>
</main>

<script>
    (function () {
        'use strict';

        var form = document.getElementById('wl-details-filter');
        var pageSize = document.getElementById('wl-details-page-size');

        if (form && pageSize) {
            pageSize.addEventListener('change', function () {
                form.submit();
            });
        }
    })();
</script>

</body>
</html>
