               function wlDetailsUrl(mode, waitingClassID) {

    var url = new URL(
        '@Url.Action("WaitingListDetails", "HousingCommandCenterDashboard", new { id = dep.Key })',
        window.location.origin
    );

    url.searchParams.set('mode', mode);

    if (waitingClassID !== undefined &&
        waitingClassID !== null) {

        url.searchParams.set(
            'waitingClassID',
            String(waitingClassID)
        );
    }

    return url.pathname + url.search;
}




            function wlKpi(parent, label, value, icon, color, mode, waitingClassID) {

    var clickable = !!mode;

    var card = wlElement(
        clickable ? 'a' : 'div',
        clickable ? 'kc dep-drill-card' : 'kc'
    );

    card.style.setProperty('--kt', color);
    card.style.setProperty('--ka', color + '10');

    if (clickable) {

        card.href = wlDetailsUrl(
            mode,
            waitingClassID
        );

        card.title = 'عرض تفاصيل ' + label;

        card.setAttribute(
            'aria-label',
            'عرض تفاصيل ' + label
        );
    }

    card.appendChild(
        wlElement('i', 'fa-solid ' + icon)
    );

    var body = wlElement('div');

    body.appendChild(
        wlElement('strong', '', wlNumber(value))
    );

    body.appendChild(
        wlElement('span', '', label)
    );

    card.appendChild(body);

    parent.appendChild(card);
}


