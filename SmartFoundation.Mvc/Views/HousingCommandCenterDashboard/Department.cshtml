                });

                var side = classes.filter(function(x) {
                    return x.classType === 'SIDE';
                });


                            wlRenderWaitingClassCards(
                'wl-main-waiting-cards',
                main,
                COLORS.purple
            );

            wlRenderWaitingClassCards(
                'wl-side-waiting-cards',
                side,
                COLORS.cyan
            );

                document.getElementById('wl-main-count')
                    .textContent = wlNumber(main.length) + ' فئة';

                document.getElementById('wl-side-count')
                    .textContent = wlNumber(side.length) + ' فئة';


                wlClassesChart('c-wl-main', main, true);

                wlClassesChart('c-wl-side', side, false);



               

            }


            /* ═══════════════════════════════════════════════
               LAZY LOADING
               ═══════════════════════════════════════════════ */

            function loadWaitingList() {

                if (waitingLoaded || waitingLoading)
                    return;

                var panel =
                    document.getElementById('t8');

                var status =
                    document.getElementById('wl-status');

                var content =
                    document.getElementById('wl-content');

                if (!panel || !status || !content)
                    return;

                waitingLoading = true;

                status.hidden = false;

                status.textContent =
                    'جاري تحميل بيانات قوائم الانتظار...';

                fetch(panel.dataset.url, {

                    credentials: 'same-origin',

                    headers: {
                        'Accept': 'application/json'
                    }

                })
                .then(function(response) {

                    if (!response.ok) {

                        throw new Error(
                            response.status === 403
                                ? 'FORBIDDEN'
                                : 'LOAD_ERROR'
                        );

                    }

                    return response.json();
                })
                .then(function(data) {

    const totalRecords =
        Number(data?.totalWaitingRecords);

    // التحميل نجح، ولكن الإدارة لا تملك
    // أي سجلات في قوائم الانتظار
    if (
        Number.isFinite(totalRecords) &&
        totalRecords === 0
    ) {
        content.hidden = true;
        status.hidden = false;

        status.textContent =
            'لا توجد بيانات لقوائم الانتظار لهذه الإدارة.';

        waitingLoaded = true;
        return;
    }

    // توجد بيانات: عرض المؤشرات والرسوم
    content.hidden = false;
    status.hidden = true;

    wlRender(data);

    waitingLoaded = true;

})
                .catch(function(error) {

                    content.hidden = true;
                    status.hidden = false;

                    status.textContent =
                        error.message === 'FORBIDDEN'
                            ? 'غير مصرح بعرض قوائم انتظار هذه الإدارة.'
                            : 'تعذر تحميل قوائم الانتظار. أعد فتح التبويب للمحاولة.';

                })
                .finally(function() {

                    waitingLoading = false;

                });

            }

        /* ── TABS ── */
        function activateDepartmentTab(tabId, updateHash) {
            if (!/^t[1-8]$/.test(tabId || '')) return;

            var btn =
                document.querySelector(
                    '.dep-tab[data-tab="' + tabId + '"]'
                );

            var panel =
                document.getElementById(tabId);

            if (!btn || !panel) return;

            document
                .querySelectorAll('.dep-tab')
                .forEach(function(b) {
                    b.classList.remove('is-active');
                });

            document
                .querySelectorAll('.dep-panel')
                .forEach(function(p) {
                    p.classList.remove('is-active');
                });

            btn.classList.add('is-active');
            panel.classList.add('is-active');
            
            if (tabId === 't8') {
                loadWaitingList();
            }

            if (updateHash &&
                window.history &&
                window.history.replaceState) {

                window.history.replaceState(
                    null,
                    '',
                    window.location.pathname +
                    window.location.search +
                    '#' +
                    tabId
                );
            }

            window.requestAnimationFrame(function() {
                window.dispatchEvent(new Event('resize'));
            });
        }

        document
            .querySelectorAll('.dep-tab')
            .forEach(function(btn) {

                btn.addEventListener(
                    'click',
                    function() {
                        activateDepartmentTab(
                            btn.dataset.tab,
                            true
                        );
                    }
                );
            });

        var requestedTab =
    (window.location.hash || '')
        .replace('#', '');

if (/^t[1-8]$/.test(requestedTab)) {
    activateDepartmentTab(requestedTab, false);
} else {
    activateDepartmentTab('t8', false);
}

        })();
    </script>
</body>
