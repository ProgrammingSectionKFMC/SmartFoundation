@model SmartFoundation.UI.ViewModels.SmartCharts.DepartmentDetailViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@{
    Layout = null;
    var dep = Model.Department;
    var housing = Model.HousingDetail;
    var occupancyLocations = Model.OccupancyLocations;
    var readiness = Model.HousingReadiness;

    var readinessMetric = dep?.Metrics?
    .FirstOrDefault(x => x.MetricKey == "m_housing_readiness");

var readinessGroups =
    readiness?.Groups?
        .OrderBy(x => x.Order)
        .ToList()
    ?? new List<SmartFoundation.UI.ViewModels.SmartCharts.DepHousingReadinessGroup>();

var readinessTotal =
    readiness?.TotalHousingUnits ?? 0;

    var alloc = Model.AllocationDetail;
    var procedures = Model.HousingProcedures;

var allocationPerformance =
    procedures?.Performance
        .FirstOrDefault(x =>
            x.WorkflowKey == "ALLOCATION");

var housingPerformance =
    procedures?.Performance
        .FirstOrDefault(x =>
            x.WorkflowKey == "HOUSING");

var extendPerformance =
    procedures?.Performance
        .FirstOrDefault(x =>
            x.WorkflowKey == "EXTEND");

var exitPerformance =
    procedures?.Performance
        .FirstOrDefault(x =>
            x.WorkflowKey == "EXIT");


    var fin = Model.FinanceDetail;
    var maint = Model.MaintenanceDetail;
    var car = Model.CarsDetail;

    var depColor = dep?.Color ?? "#0f766e";
    var depName = dep?.Name ?? "تفاصيل الإدارة";
    var depOverall = dep?.OverallCompletionPercent?.ToString("0.0") ?? "—";

    string Fmt(decimal v) => v.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
    string FmtSar(decimal v) => v.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " <span class=\"sar-icon\"></span>";

    var jsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    decimal? occPct =
    housing != null && housing.TotalUnits > 0
        ? Math.Round(
            (decimal)housing.Occupied /
            housing.TotalUnits * 100m, 1)
        : null;

decimal? vacPct =
    housing != null && housing.TotalUnits > 0
        ? Math.Round(
            (decimal)housing.Vacant /
            housing.TotalUnits * 100m, 1)
        : null;

    var mPct = maint != null && maint.PlannedJobs > 0 ? Math.Round((decimal)maint.CompletedJobs / maint.PlannedJobs * 100, 1) : 0m;
    
}

@functions
{
    private static string FmtDuration(decimal? durationDays)
    {
        if (!durationDays.HasValue)
            return "—";

        var totalMinutes =
            (long)Math.Round(
                durationDays.Value * 24m * 60m,
                MidpointRounding.AwayFromZero);

        if (totalMinutes <= 0)
            return "أقل من دقيقة";

        var days =
            totalMinutes / 1440;

        var hours =
            (totalMinutes % 1440) / 60;

        var minutes =
            totalMinutes % 60;

        var result = "";

        if (days > 0)
{
    if (days == 1)
    {
        result += "يوم واحد";
    }
    else if (days == 2)
    {
        result += "يومان";
    }
    else if (days >= 3 && days <= 10)
    {
        result += $"{days} أيام";
    }
    else
    {
        result += $"{days} يوم";
    }
}

        if (hours > 0)
        {
            if (!string.IsNullOrWhiteSpace(result))
                result += " ";

            result += $"{hours} ساعة";
        }

        if (minutes > 0)
        {
            if (!string.IsNullOrWhiteSpace(result))
                result += " ";

            result += $"{minutes} دقيقة";
        }

        return string.IsNullOrWhiteSpace(result)
            ? "أقل من دقيقة"
            : result;
    }
}


