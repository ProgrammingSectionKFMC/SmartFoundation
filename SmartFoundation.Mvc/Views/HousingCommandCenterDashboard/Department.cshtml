            mk('c-maint-requests-types',
                hbar(
                    dMrt.labels,
                    dMrt.values,
                    [COLORS.warning, COLORS.cyan, COLORS.accent, COLORS.purple, COLORS.gray]
                )
            );
        }

        /* ══ 2 — فئات ══ */
