        }

        .readiness-drill-link {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: inherit;
            text-decoration: none;
            cursor: pointer;
        }

        .summary-item:has(.readiness-drill-link) {
            transition: background .16s ease, transform .16s ease;
