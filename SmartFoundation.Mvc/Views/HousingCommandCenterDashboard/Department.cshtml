    <script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/lib/chartjs/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
    <script>
        (function(){
        'use strict';

        /* ── Global Chart Settings — Official Style ── */
        var F = "'Segoe UI', 'Cairo', Tahoma, Arial, sans-serif";
        Chart.defaults.font.family = F;
        Chart.defaults.font.size = 12;
        Chart.defaults.animation.duration = 600;
        Chart.defaults.animation.easing = 'easeOutQuart';
        Chart.defaults.plugins.legend.labels.usePointStyle = true;
        Chart.defaults.plugins.legend.labels.pointStyle = 'circle';
        Chart.defaults.plugins.legend.labels.boxWidth = 8;
        Chart.defaults.plugins.legend.labels.boxHeight = 8;
        Chart.defaults.plugins.legend.labels.padding = 14;
        Chart.defaults.plugins.legend.labels.font = { size: 11, weight: '600' };
        Chart.defaults.plugins.legend.labels.color = '#414148';

        /* ── Official Government Color Palette ── */
        var COLORS = {
            primary: '#1e3a5f',
            primaryLight: '#2c5282',
            accent: '#c9a227',
            success: '#276749',
            successLight: '#38a169',
            info: '#2b6cb0',
            infoLight: '#4299e1',
            warning: '#c05621',
            warningLight: '#dd6b20',
            danger: '#9b2c2c',
            dangerLight: '#c53030',
            purple: '#553c9a',
            purpleLight: '#6b46c1',
            cyan: '#086f83',
            cyanLight: '#0987a0',
            gray: '#4a5568',
            grayLight: '#a0aec0'
        };

        var PAL = [COLORS.primary, COLORS.info, COLORS.warning, COLORS.danger, COLORS.purple, COLORS.cyan, COLORS.success, COLORS.accent];

        /* ── Helpers ── */
        function get(id) {
            var e = document.getElementById(id);
            if (!e) return null;
            try { return JSON.parse(e.textContent); } catch(x) { return null; }
        }

        function mk(id, cfg) {
            var c = document.getElementById(id);
            if (!c) return;
            cfg.options = cfg.options || {};
            cfg.options.responsive = true;
            cfg.options.maintainAspectRatio = false;
            new Chart(c, cfg);
        }

        /* ── Doughnut Chart — Official Style ── */
        function donut(labels, data, colors, cut) {
            var tot = data.reduce(function(a,b){ return a+b; }, 0);
            return {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors,
                        borderWidth: 2,
                        borderColor: '#fff',
                        hoverOffset: 6,
                        hoverBorderWidth: 3,
                        hoverBorderColor: '#fff'
                    }]
                },
                options: {
                    cutout: cut || '65%',
                    spacing: 1,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: { size: 11 }, padding: 16 }
                        },
                        datalabels: { display: false },
                        tooltip: {
                            backgroundColor: '#1a1a2e',
                            titleFont: { size: 13, weight: '700' },
                            bodyFont: { size: 12 },
                            padding: 12,
                            cornerRadius: 6,
                            callbacks: {
                                label: function(c) {
                                    var p = tot > 0 ? Math.round(c.parsed/tot*100) : 0;
                                    return ' ' + c.label + ': ' + c.parsed.toLocaleString('en-US') + ' (' + p + '%)';
                                }
                            }
                        }
                    }
                }
            };
        }

        /* ── Horizontal Bar Chart — Official Style ── */
        function hbar(labels, data, colors) {
            return {
                type: 'bar',
                plugins: [ChartDataLabels],
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors || PAL,
                        borderRadius: 4,
                        borderSkipped: false,
                        barThickness: 18,
                        maxBarThickness: 22
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end',
                            align: 'start',
                            offset: 8,
                            color: '#ffffff',
                            font: { weight: '700', size: 11 },
                            formatter: function(v) { return v.toLocaleString('en-US'); }
                        },
                        tooltip: {
                            backgroundColor: '#1a1a2e',
                            padding: 12,
                            cornerRadius: 6,
                            callbacks: {
                                label: function(c) { return ' ' + c.parsed.x.toLocaleString('en-US'); }
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,.04)', drawBorder: false },
                            ticks: { font: { size: 11 }, color: '#718096' }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { size: 12, weight: '600' }, color: '#2d3748' }
                        }
                    }
                }
            };
        }

        /* ══ 1 — حالة الوحدات ══ */
        var d1 = get('d-unit-status');
        if (d1) mk('c-unit-status', donut(d1.labels, d1.values, [COLORS.success, COLORS.danger, COLORS.warning, COLORS.danger, COLORS.purple, COLORS.cyan]));


  /* ══════════════════════════════════════════════════════
   جاهزية الوحدات السكنية — All Current Statuses
   ══════════════════════════════════════════════════════ */

var dReadiness =
    get('d-readiness-status');

if (
    dReadiness &&
    Array.isArray(dReadiness.labels) &&
    dReadiness.labels.length > 0
) {

    var readinessItems =
        dReadiness.labels.map(
            function (label, index) {

                return {
                    label: label,
                    value: dReadiness.values[index],
                    key: dReadiness.keys[index]
                };

            });


    var readinessCanvas =
        document.getElementById(
            'c-readiness-status'
        );


    var readinessColorMap = {

        OCCUPIED:
            COLORS.success,

        READY:
            '#0f766e',

        ALLOCATION:
            COLORS.info,

        MAINTENANCE:
            COLORS.warning,

        QUALITY:
            COLORS.purple,

        GENERAL_SERVICES:
            COLORS.cyan,

        HOUSING_DEPARTMENT:
            '#805ad5',

        EXECUTION:
            '#b7791f',

        VACANT_PENDING:
            COLORS.danger,

        NO_ACTIVE_ACTION:
            COLORS.gray,

        OTHER:
            COLORS.grayLight
    };


    new Chart(
        readinessCanvas,
        {
            type: 'bar',

            plugins: [
                ChartDataLabels
            ],

            data: {

                labels:
                    readinessItems.map(
                        function (x) {
                            return x.label;
                        }),

                datasets: [
                    {
                        label: 'عدد الوحدات',

                        data:
                            readinessItems.map(
                                function (x) {
                                    return x.value;
                                }),

                        backgroundColor:
                            readinessItems.map(
                                function (x) {
                                    return readinessColorMap[x.key]
                                        || COLORS.gray;
                                }),

                        borderRadius: 5,
                        borderSkipped: false,

                        maxBarThickness: 50
                    }
                ]
            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                animation: {
                    duration: 600,
                    easing: 'easeOutQuart'
                },

                interaction: {
                    mode: 'index',
                    intersect: false
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    datalabels: {

                        anchor: 'end',
                        align: 'top',
                        offset: 2,

                        color: '#2d3748',

                        font: {
                            size: 10,
                            weight: '700'
                        },

                        formatter:
                            function (value) {

                                return value > 0
                                    ? value.toLocaleString('en-US')
                                    : '';

                            }
                    },

                    tooltip: {

                        backgroundColor: '#1a1a2e',
                        padding: 12,
                        cornerRadius: 6,

                        callbacks: {

                            label:
                                function (context) {

                                    return ' ' +
                                        context.parsed.y
                                            .toLocaleString('en-US') +
                                        ' وحدة';

                                }
                        }
                    }
                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {

                            autoSkip: false,

                            color: '#2d3748',

                            font: {
                                size: 10,
                                weight: '600'
                            },

                            maxRotation: 0,
                            minRotation: 0
                        }
                    },

                    y: {

                        beginAtZero: true,
                        grace: '10%',

                        grid: {
                            color: 'rgba(0,0,0,.04)',
                            drawBorder: false
                        },

                        ticks: {

                            color: '#718096',

                            font: {
                                size: 11
                            }
                        }
                    }
                }
            }
        }
    );
}



        /* ══════════════════════════════════════════════════════
   الإشغال حسب الموقع السكني — Auto Rotation
   ══════════════════════════════════════════════════════ */

var dOccLocations = get('d-occupancy-locations');

if (
    dOccLocations &&
    Array.isArray(dOccLocations.items) &&
    dOccLocations.items.length > 0
) {
    var occupancyItems = dOccLocations.items;

    // عدد المواقع المعروضة في كل شاشة
    var occupancyPageSize = 5;

    var occupancyPageIndex = 0;

    var occupancyTotalPages =
        Math.ceil(
            occupancyItems.length /
            occupancyPageSize
        );

    var occupancyCanvas =
        document.getElementById(
            'c-occupancy-locations'
        );

    var occupancyPageBadge =
        document.getElementById(
            'occupancy-location-page'
        );

    function getOccupancyPage() {

        var start =
            occupancyPageIndex *
            occupancyPageSize;

        return occupancyItems.slice(
            start,
            start + occupancyPageSize
        );
    }

    function updateOccupancyPageBadge() {

        if (!occupancyPageBadge)
            return;

        occupancyPageBadge.textContent =
            (occupancyPageIndex + 1) +
            ' / ' +
            occupancyTotalPages;
    }

    var firstOccupancyPage =
        getOccupancyPage();

    var occupancyLocationsChart =
        new Chart(
            occupancyCanvas,
            {
                type: 'bar',

                plugins: [
                    ChartDataLabels
                ],

                data: {
                    labels:
                        firstOccupancyPage.map(
                            function (x) {
                                return x.name;
                            }),

                    datasets: [
                        {
                            label: 'الإجمالي',
                            data:
                                firstOccupancyPage.map(
                                    function (x) {
                                        return x.total;
                                    }),

                            backgroundColor:
                                COLORS.grayLight,

                            borderRadius: 4,
                            borderSkipped: false
                        },

                        {
                            label: 'المشغول',
                            data:
                                firstOccupancyPage.map(
                                    function (x) {
                                        return x.occupied;
                                    }),

                            backgroundColor:
                                COLORS.success,

                            borderRadius: 4,
                            borderSkipped: false
                        },

                        {
                            label: 'الشاغر',
                            data:
                                firstOccupancyPage.map(
                                    function (x) {
                                        return x.vacant;
                                    }),

                            backgroundColor:
                                COLORS.danger,

                            borderRadius: 4,
                            borderSkipped: false
                        }
                    ]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    animation: {
                        duration: 600,
                        easing: 'easeOutQuart'
                    },

                    interaction: {
                        mode: 'index',
                        intersect: false
                    },

                    plugins: {

                        legend: {
                            position: 'top',

                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 18,
                                font: {
                                    size: 11,
                                    weight: '600'
                                }
                            }
                        },

                        datalabels: {
                            anchor: 'end',
                            align: 'top',
                            offset: 2,

                            color: '#2d3748',

                            font: {
                                size: 10,
                                weight: '700'
                            },

                            formatter: function (value) {
                                return value > 0
                                    ? value.toLocaleString('en-US')
                                    : '';
                            }
                        },

                        tooltip: {
                            backgroundColor: '#1a1a2e',
                            padding: 12,
                            cornerRadius: 6,

                            callbacks: {

                                afterBody: function (items) {

                                    if (!items ||
                                        items.length === 0)
                                        return '';

                                    var index =
                                        items[0].dataIndex;

                                    var page =
                                        getOccupancyPage();

                                    var item =
                                        page[index];

                                    if (!item)
                                        return '';

                                    return [
                                        '',
                                        'نسبة الإشغال: ' +
                                        Number(
                                            item.percent
                                        ).toFixed(2) +
                                        '%'
                                    ];
                                }
                            }
                        }
                    },

                    scales: {

                        x: {
                            stacked: false,

                            grid: {
                                display: false
                            },

                            ticks: {
                                autoSkip: false,
                                maxRotation: 0,
                                minRotation: 0,

                                font: {
                                    size: 10,
                                    weight: '600'
                                },

                                color: '#2d3748'
                            }
                        },

                        y: {
                            beginAtZero: true,

                            grid: {
                                color:
                                    'rgba(0,0,0,.05)'
                            },

                            ticks: {
                                precision: 0,

                                font: {
                                    size: 10
                                },

                                color: '#718096'
                            }
                        }
                    }
                }
            });

    updateOccupancyPageBadge();

    function showNextOccupancyPage() {

        if (occupancyTotalPages <= 1)
            return;

        occupancyPageIndex =
            (
                occupancyPageIndex + 1
            ) %
            occupancyTotalPages;

        var page =
            getOccupancyPage();

        occupancyLocationsChart.data.labels =
            page.map(
                function (x) {
                    return x.name;
                });

        occupancyLocationsChart
            .data
            .datasets[0]
            .data =
            page.map(
                function (x) {
                    return x.total;
                });

        occupancyLocationsChart
            .data
            .datasets[1]
            .data =
            page.map(
                function (x) {
                    return x.occupied;
                });

        occupancyLocationsChart
            .data
            .datasets[2]
            .data =
            page.map(
                function (x) {
                    return x.vacant;
                });

        occupancyLocationsChart.update();

        updateOccupancyPageBadge();
    }

    // الانتقال إلى 5 مواقع جديدة كل 8 ثوانٍ
    var occupancyRotationTimer =
        setInterval(
            showNextOccupancyPage,
            8000
        );

    // إيقاف التدوير أثناء وضع المؤشر على الرسم
    occupancyCanvas.addEventListener(
        'mouseenter',
        function () {

            clearInterval(
                occupancyRotationTimer
            );
        });

    // استكمال التدوير بعد إبعاد المؤشر
    occupancyCanvas.addEventListener(
        'mouseleave',
        function () {

            clearInterval(
                occupancyRotationTimer
            );

            occupancyRotationTimer =
                setInterval(
                    showNextOccupancyPage,
                    8000
                );
        });
}





        /* ══ 1b — مساحات ══ */
        var dA = get('d-areas');
        if (dA) mk('c-areas', hbar(dA.labels, dA.values, [COLORS.primary, COLORS.info, COLORS.warning, COLORS.purple, COLORS.danger]));

        /* ══ 1c — غرف ══ */
        var dR = get('d-rooms');
        if (dR) mk('c-rooms', hbar(dR.labels, dR.values, [COLORS.info, COLORS.primary, COLORS.warning, COLORS.purple, COLORS.danger, COLORS.cyan]));


         /* ══ 1b — العربات ══ */
